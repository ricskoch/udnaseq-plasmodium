pfa3d7_cytoband <- read.delim("D:/Jegyzőkönyvek/Plasmodium NGS/structural_rearrangement/pfa3d7_cytoband.txt", header=FALSE)
View(pfa3d7_cytoband)
`0815.Plasmodium.MAPQfiltered.IPvsINPUT.log2` <- read.delim("D:/Jegyzőkönyvek/Plasmodium NGS/Statistics/segtools_second(unscaled)_results/0815.Plasmodium.MAPQfiltered.IPvsINPUT.log2.bedGraph", header=FALSE, comment.char="#")
View(`0815.Plasmodium.MAPQfiltered.IPvsINPUT.log2`)
var_genes <- read.delim("D:/Jegyzőkönyvek/Plasmodium NGS/CHIP-seq_data/BED_files/var_genes.bed", header=FALSE)
View(var_genes)
circos.clear()
library(circlize)
circos.clear()
circos.par('start.degree' = 90)
circos.par('gap.degree' = 2)
circos.initializeWithIdeogram(cytoband = pfa3d7_cytoband, chromosome.index = paste('Pf3D7_', sprintf("%02d", c(1:14)), '_v3', sep = '')  , plotType = NULL)
circos.genomicTrack(`0815.Plasmodium.MAPQfiltered.IPvsINPUT.log2.scaled`, ylim = c(-0.2, 1.3), numeric.column = 4, panel.fun = function(region, value, ...) {
circos.genomicLines(region, value, col = 'red')
circos.genomicRect(var_genes, ytop = 0.2, ybottom = 0)
circos.genomicLines(region, value = 0)
circos.genomicLines(region, value = min(CELL_META$ylim))
circos.genomicLines(region, value = max(CELL_META$ylim))
}, bg.border = NA, track.height = 0.5)
circos.genomicTrack(`0815.Plasmodium.MAPQfiltered.IPvsINPUT.log2`, ylim = c(-0.2, 1.3), numeric.column = 4, panel.fun = function(region, value, ...) {
