### Visulization using Circos in Rstudio

## Circos requires the following: cytoband file for the chromosome information
## Cytoband format:
chrom	chromStart	chromEnd	name	gieStain

# Import cytoband from cytoband file as read.delim, then you can start plotting with the following commands (useful: https://jokergoo.github.io/circlize_book/book/initialize-genomic-plot.html)

circos.clear()
circos.par('start.degree' = 90)
circos.par('gap.degree' = 2)
circos.initializeWithIdeogram(cytoband = pfa3d7_cytoband, chromosome.index = paste('Pf3D7_', sprintf("%02d", c(1:14)), '_v3', sep = '')  , plotType = NULL)
circos.track(ylim = c(0, 1), panel.fun = function(x, y) {
     chr = CELL_META$sector.index
     xlim = CELL_META$xlim
     ylim = CELL_META$ylim
     circos.rect(xlim[1], 0, xlim[2], 1, col = 'black')
     circos.text(mean(xlim), mean(ylim), chr, cex = 0.7, col = "white",
                 facing = "inside", niceFacing = TRUE)
 }, track.height = 0.15, bg.border = NA)

# After having an ideogram, we need to add the tracks generated with Delly, but vcf need to be formated first to be readable

sv = read.table('~/Documents/Plasmodium_NGS/structural_rearrangement/3d7.structual.rearrangement.vcf')

## To plot deletion, inversion and insertion data use the following

chrEnd=NULL
posEnd=NULL
for (i in 1:dim(sv)[1]) {
    addInfo=strsplit(as.character(sv[i,8]),split=";")
    chrInf=strsplit(addInfo[[1]][3],split="=")
    chrEnd=c(chrEnd,chrInf[[1]][2])
    posInf=strsplit(addInfo[[1]][4],split="=")
    posEnd=c(posEnd,posInf[[1]][2])
}
svTable=data.frame(sv[,1], as.numeric(sv[,2]), as.numeric(posEnd), chrEnd, as.character(sv[,5]))


typeE=c("<DEL>","<INS>","<INV>")
colE=c("blue","black","green")
for (i in 1:3) {
    bed_list=svTable[svTable[,5]==typeE[i],]
    circos.genomicTrackPlotRegion(bed_list, stack=TRUE, panel.fun = function(region, value, ...) {
        circos.genomicPoints(region, value, cex = 0.5, pch = 16, col = colE[i], ...)
    })
}

title("Structural variants")
legend(1,1,legend=c("SV-DELETION","SV-INSERTION","SV-INVERSION"),col=c("blue","black","green"),pch=c(16,16,16,16),cex=0.75,title="Tracks:",bty='n')

