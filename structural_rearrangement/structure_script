for (i in 1:dim(tra)[1]) {
	traInfo = strsplit(as.character(tra[i,8]), split = ";")
	if (tra[i, 7] == 'PASS') {
		chrInfEnd = strsplit(as.character(traInfo[[1]][5]), split="=")
		chrEnd = c(chrEnd, chrInfEnd[[1]][2])
		posInfEnd = strsplit(as.character(traInfo[[1]][6]), split="=")
		posEnd = c(posEnd, posInfEnd[[1]][2])
		chrStart = c(chrStart, tra[i,1])
		posStart = c(posStart, tra[i,2])
		}
}
traTable = data.frame(chrStart, as.numeric(posStart), chrEnd, as.numeric(posEnd))


## circos.link requires the section (i.e. chromosome name) and the location (loci) for the start and end positions respectively
## If the location is a two-value vector then it is going to be a belt

for (i in 1:dim(traTable)[1]) {
    circos.link(traTable[i,1],traTable[i,2],traTable[i,3],traTable[i,4])
}

