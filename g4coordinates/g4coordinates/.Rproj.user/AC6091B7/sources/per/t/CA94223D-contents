library(ggplot2)

summary(g4distance_to_0p5_merged$V11)
overlap <- ggplot(g4distance_to_0p5_merged, aes(x=V11))+
  geom_histogram(binwidth=1)+
  theme_bw()+
  coord_cartesian(xlim=c(-20,20),ylim=c(0,1000))+
  xlab("Distance to closest G4-coordinates (bp)")+
  ylab("Count")
plot(overlap)
